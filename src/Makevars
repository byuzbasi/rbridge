
# Use the same Armadillo configuration in the engine and generated wrappers.
PKG_CPPFLAGS = -DARMA_DONT_USE_OPENMP
# Empty OpenMP flags give a sequential build on unsupported toolchains.
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
